{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Design Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "surface",
    "observation",
    "evidence",
    "category",
    "principles",
    "impact",
    "proposal",
    "validation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "surface": {
      "type": "string"
    },
    "observation": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind",
        "details",
        "confidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "observed-browser",
            "observed-code",
            "screenshot",
            "user-report",
            "inference"
          ]
        },
        "details": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "category": {
      "enum": [
        "hierarchy",
        "color",
        "typography",
        "layout",
        "balance",
        "rhythm",
        "flow",
        "systems",
        "imagery",
        "brand"
      ]
    },
    "principles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "balance",
          "contrast",
          "emphasis",
          "movement",
          "pattern",
          "proportion",
          "unity"
        ]
      }
    },
    "impact": {
      "enum": [
        "blocker",
        "high",
        "medium",
        "low"
      ]
    },
    "proposal": {
      "type": "string"
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "wcag_sc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "confirmed",
        "hypothesis",
        "resolved",
        "unverified"
      ]
    }
  }
}

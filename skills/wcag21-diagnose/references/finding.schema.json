    "category": {
      "type": "string",
      "enum": [
        "alt-media",
        "semantics",
        "visual",
        "keyboard",
        "timing-motion",
        "pointer",
        "navigation",
        "language",
        "forms",
        "at-status"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "A",
        "AA",
        "AAA"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "fail",
        "pass",
        "not_applicable",
        "not_tested",
        "needs_manual_review"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "element_or_route": {
      "type": "string"
    },
    "task_state": {
      "type": "string"
    },
    "device_and_at": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "remediation": {
      "type": "string"
    },
    "verification_plan": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "blocker",
        "high",
        "medium",
        "low"
      ]
    },
    "applicability_reason": {
      "type": "string"
    },
    "test_method": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "standard": {
      "type": "string",
      "enum": [
        "WCAG 2.1",
        "WCAG 2.2"
      ]
    }
  },
  "description": "Schema validates surface field types and superset criterion IDs; report checker validates version-specific criterion membership and level."
}

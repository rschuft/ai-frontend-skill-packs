    "id",
    "criterion_id",
    "status",
    "scope",
    "evidence",
    "remediation",
    "verification_plan",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_id": {
      "type": "string",
